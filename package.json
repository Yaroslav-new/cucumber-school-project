{
  "name": "cucumber_practice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:json": "cucumber-js -p json",
    "test:html": "cucumber-js -p html",
    "test:unit": "mocha src/shouty/test",
    "test:unit:ci": "mocha src/shouty/test --reporter xunit --reporter-option output=reports/unit-junit.xml",
    "test:bdd:ci": "cucumber-js -p ci",
    "test:all": "npm run test:unit && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "description": "Cucumber School practice project: BDD tests for the Shouty app",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "hamjest": "^4.1.0",
    "mocha": "^12.0.3"
  }
}
